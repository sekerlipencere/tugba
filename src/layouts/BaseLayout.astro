---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/literata';
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/global.css';
import siteConfig from '../data/site-config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ReadingProgress from '../components/ReadingProgress.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  showReadingProgress?: boolean;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  ogImage = '/og/anasayfa.png',
  ogType = 'website',
  showReadingProgress = false
} = Astro.props;

const pageTitle = title === siteConfig.title ? title : `${title} | ${siteConfig.name}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://tugba.yusufd-polar.workers.dev');
const resolvedOgImage = new URL(ogImage, Astro.site ?? 'https://tugba.yusufd-polar.workers.dev').toString();
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.title} href="/rss.xml" />
    <link rel="canonical" href={canonicalUrl.toString()} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Sosyal Medya Önizleme -->
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.toString()} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <ClientRouter />

    <script is:inline>
      (function () {
        function applySavedTheme(doc) {
          try {
            const saved = localStorage.getItem('tugba-theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            const useDark = saved === 'dark' || (!saved && prefersDark);
            doc.documentElement.classList.toggle('dark', useDark);
          } catch (e) {}
        }

        applySavedTheme(document);

        document.addEventListener('astro:before-swap', function (ev) {
          applySavedTheme(ev.newDocument);
        });
      })();
    </script>
  </head>
  <body class="flex min-h-dvh flex-col bg-canvas text-ink">
    {showReadingProgress && <ReadingProgress />}

    <a
      href="#icerik"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-surface focus:px-4 focus:py-2 focus:font-sans focus:text-sm focus:text-ink print:hidden"
    >
      İçeriğe geç
    </a>

    <Header />

    <main id="icerik" class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
