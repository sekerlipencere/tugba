---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';
import { POST_CATEGORIES } from '../../content.config';
import { sortByPublishDateDesc } from '../../utils/format';

const posts = sortByPublishDateDesc(await getCollection('yazilar'));
---

<BaseLayout
  title="Yazılar"
  description="Rehberlik notları, kişisel denemeler, kitap ve sinema okumaları."
  ogImage="/og/yazilar.png"
>
  <div class="mx-auto max-w-5xl px-6 pt-6 sm:px-8 sm:pt-10">
    <header class="max-w-[58ch] space-y-4 pb-10">
      <h1 class="font-serif text-3xl font-medium tracking-[-0.02em] text-ink sm:text-4xl">
        Yazılar
      </h1>
      <p class="font-serif text-[1.08rem] leading-[1.75] text-muted">
        Okul koridorlarından mesleki notlar, günlük gözlemler, altını çizdiğim kitaplar ve filmler
        üzerine okumalar.
      </p>
    </header>

    <div class="mb-8 flex flex-wrap gap-1.5" role="group" aria-label="Yazı kategorisi seç">
      <button type="button" class="filter-tab" data-archive-filter="Tümü" aria-pressed="true">
        Tümü ({posts.length})
      </button>
      {
        POST_CATEGORIES.map((category) => {
          const count = posts.filter((p) => p.data.category === category).length;
          return (
            <button
              type="button"
              class="filter-tab"
              data-archive-filter={category}
              aria-pressed="false"
            >
              {category} ({count})
            </button>
          );
        })
      }
    </div>

    <div id="archive-post-list" class="divide-y divide-rule">
      {posts.map((post) => <PostRow post={post} showExcerpt={true} />)}
    </div>

    <p id="archive-empty-state" class="hidden py-10 font-sans text-sm text-muted">
      Bu kategoride henüz yazı bulunmuyor. Diğer raflara geçebilirsin.
    </p>
  </div>
</BaseLayout>

<script>
  function bindArchiveFilter() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-archive-filter]');
    const list = document.getElementById('archive-post-list');
    const empty = document.getElementById('archive-empty-state');
    if (!buttons.length || !list) return;

    const applyFilter = (selected: string) => {
      buttons.forEach((btn) =>
        btn.setAttribute('aria-pressed', String(btn.dataset.archiveFilter === selected))
      );
      let visibleCount = 0;
      list.querySelectorAll<HTMLElement>('article[data-category]').forEach((article) => {
        const match = selected === 'Tümü' || article.dataset.category === selected;
        article.classList.toggle('hidden', !match);
        if (match) visibleCount += 1;
      });
      if (empty) empty.classList.toggle('hidden', visibleCount > 0);
    };

    const params = new URLSearchParams(window.location.search);
    const initial = params.get('kategori');
    if (initial) applyFilter(initial);

    buttons.forEach((button) => {
      if (button.dataset.bound === 'true') return;
      button.dataset.bound = 'true';
      button.addEventListener('click', () => {
        const selected = button.dataset.archiveFilter ?? 'Tümü';
        applyFilter(selected);
      });
    });
  }

  document.addEventListener('astro:page-load', bindArchiveFilter);
</script>
