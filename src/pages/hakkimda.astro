---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import siteConfig from '../data/site-config';

const page = await getEntry('pages', 'hakkimda');
const rendered = page ? await render(page) : null;
const Content = rendered?.Content;
---

<BaseLayout
  title={page?.data.title ?? 'Hakkımda'}
  description={page?.data.description ?? 'Tuğba hakkında kısa bilgi ve iletişim.'}
  ogImage="/og/hakkimda.png"
>
  <div class="mx-auto max-w-5xl px-6 pt-6 sm:px-8 sm:pt-10">
    <div class="grid gap-12 lg:grid-cols-[1.25fr_0.75fr] lg:items-start lg:gap-16">
      <div>
        <header class="max-w-[56ch] space-y-4 pb-8">
          <h1 class="font-serif text-3xl font-medium tracking-[-0.02em] text-ink sm:text-4xl">
            {page?.data.title ?? 'Hakkımda'}
          </h1>
          {
            page?.data.subtitle && (
              <p class="font-serif text-[1.1rem] leading-[1.75] text-muted">
                {page.data.subtitle}
              </p>
            )
          }
        </header>

        {
          Content && (
            <div class="editorial-prose">
              <Content />
            </div>
          )
        }
      </div>

      <aside class="space-y-8">
        <figure>
          <div class="overflow-hidden rounded-[2px] bg-surface">
            <img
              src="/images/hakkimda-tas-evler.jpg"
              alt="Kapadokya yamacında taş evler, saksılar ve yeşil bahçeler"
              width="1197"
              height="896"
              class="aspect-[4/3] w-full object-cover"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="mt-3 font-sans text-xs text-muted">
            Taş duvarlar, yeşil avlular ve sakin bir öğleden sonra
          </figcaption>
        </figure>

        <div class="rounded-[2px] bg-surface p-7 space-y-4">
          <h2 class="font-serif text-xl font-medium text-ink">İletişim</h2>
          <p class="font-serif text-[0.98rem] leading-[1.7] text-muted">
            Bir yazı üzerine konuşmak, kitap önermek ya da rehberlik konularında merak ettiğin bir
            başlığı paylaşmak istersen yazabilirsin.
          </p>
          <div class="flex flex-col gap-2 pt-1 font-sans text-sm">
            <a href={`mailto:${siteConfig.author.email}`} class="text-link w-fit">
              E-posta gönder ({siteConfig.author.email})
            </a>
            <a
              href={siteConfig.author.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="text-link w-fit"
            >
              Instagram’da takip et ({siteConfig.author.instagramHandle})
            </a>
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
