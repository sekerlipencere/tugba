---
import siteConfig from '../data/site-config';
import BotanicalMark from './BotanicalMark.astro';
---

<footer class="mt-24 pb-14 pt-12 sm:mt-32 print:hidden">
  <div class="mx-auto max-w-5xl px-6 sm:px-8">
    <div class="mb-10 flex items-center gap-4 text-botanical/80">
      <BotanicalMark class="h-8 w-8 shrink-0" />
      <div class="h-px flex-1 bg-rule"></div>
    </div>

    <div class="grid gap-8 md:grid-cols-[1.4fr_1fr] md:items-start">
      <div class="space-y-3">
        <p class="font-serif text-base text-ink">
          {siteConfig.author.name}
          <span class="block font-sans text-sm text-muted mt-0.5">
            {siteConfig.author.role}
          </span>
        </p>
        <p class="max-w-[56ch] font-sans text-xs leading-relaxed text-muted">
          {siteConfig.ethicsNote}
        </p>
      </div>

      <div class="flex flex-col gap-3 md:items-end">
        <nav aria-label="Alt menü" class="flex flex-wrap gap-x-5 gap-y-2 md:justify-end">
          {
            siteConfig.footerNavLinks.map((link) => (
              <a
                href={link.href}
                class="font-sans text-sm text-muted no-underline hover:text-ink transition-colors"
              >
                {link.text}
              </a>
            ))
          }
        </nav>

        <div class="flex flex-wrap gap-x-5 gap-y-1 font-sans text-sm text-muted md:justify-end">
          <a
            href={siteConfig.author.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="no-underline hover:text-sea transition-colors"
          >
            Instagram ({siteConfig.author.instagramHandle})
          </a>
          <a
            href={`mailto:${siteConfig.author.email}`}
            class="no-underline hover:text-sea transition-colors"
          >
            E-posta
          </a>
          <a
            href="/rss.xml"
            class="no-underline hover:text-sea transition-colors"
          >
            RSS
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
