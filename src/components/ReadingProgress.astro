<div
  id="reading-progress"
  aria-hidden="true"
  class="pointer-events-none fixed top-0 left-0 z-50 h-[2px] w-full origin-left scale-x-0 bg-sea transition-transform duration-75 ease-out print:hidden"
></div>

<script>
  let cleanupReadingProgress: (() => void) | null = null;

  function initReadingProgress() {
    if (cleanupReadingProgress) {
      cleanupReadingProgress();
      cleanupReadingProgress = null;
    }

    const bar = document.getElementById('reading-progress');
    if (!bar) return;

    const update = () => {
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      if (scrollable <= 0) {
        bar.style.transform = 'scaleX(0)';
        return;
      }
      const progress = Math.min(1, Math.max(0, window.scrollY / scrollable));
      bar.style.transform = `scaleX(${progress.toFixed(4)})`;
    };

    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });

    cleanupReadingProgress = () => {
      window.removeEventListener('scroll', update);
      window.removeEventListener('resize', update);
    };
  }

  document.addEventListener('astro:page-load', initReadingProgress);
  document.addEventListener('astro:before-preparation', () => {
    if (cleanupReadingProgress) {
      cleanupReadingProgress();
      cleanupReadingProgress = null;
    }
  });
</script>
